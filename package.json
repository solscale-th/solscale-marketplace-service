{
  "name": "store-service",
  "version": "0.1.0",
  "description": "GraphQL + REST backend boilerplate (Apollo Server, Sequelize/Postgres, TypeScript)",
  "main": "index.js",
  "engines": {
    "node": "~20.11.0"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "codegen": "graphql-codegen --config codegen.ts",
    "build:types": "npm run codegen && tsc --emitDeclarationOnly",
    "build:js": "babel src --out-dir dist --extensions \".ts,.tsx\" --source-maps inline --copy-files",
    "build": "rm -rf dist && npm run build:types && npm run build:js",
    "start": "nodemon",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "docs:build": "spectaql spectaql.yml --target-dir docs/api",
    "docs:dev": "spectaql spectaql.yml --target-dir docs/api -D",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@babel/cli": "~7.23.9",
    "@babel/core": "^7.29.0",
    "@babel/node": "~7.23.9",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "~7.23.3",
    "@eslint/js": "~9.10.0",
    "@graphql-codegen/cli": "~6.1.2",
    "@graphql-codegen/introspection": "~5.0.0",
    "@graphql-codegen/typescript": "~5.0.8",
    "@graphql-codegen/typescript-resolvers": "~5.1.6",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/body-parser": "~1.19.5",
    "@types/cors": "~2.8.17",
    "@types/express": "~4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "~4.17.7",
    "@types/multer": "~1.4.12",
    "@types/node": "~20.11.16",
    "@types/sequelize": "~4.28.20",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "~12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "~15.9.0",
    "husky": "~9.0.10",
    "lint-staged": "~15.2.10",
    "nodemon": "^3.1.11",
    "prettier": "~3.2.5",
    "sequelize-cli": "^6.6.5",
    "spectaql": "^3.0.9",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@apollo/server": "~5.4.0",
    "@as-integrations/express4": "^1.1.2",
    "@graphql-tools/load-files": "~7.0.0",
    "@graphql-tools/merge": "~9.0.1",
    "@graphql-tools/schema": "~10.0.2",
    "bcrypt": "^6.0.0",
    "body-parser": "~1.20.3",
    "compression": "~1.8.1",
    "cors": "~2.8.5",
    "dotenv": "~16.4.5",
    "express": "^4.22.1",
    "google-auth-library": "^10.9.0",
    "graphql": "~16.13.0",
    "jsonwebtoken": "~9.0.2",
    "lodash": "~4.17.21",
    "moment": "~2.30.1",
    "morgan": "~1.10.0",
    "multer": "~1.4.5-lts.1",
    "pg": "~8.14.1",
    "sequelize": "~6.37.2",
    "uuid": "~10.0.0"
  }
}
