NODE_ENV=development
PORT=8000
APP_NAME=store-service

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=store_service
DB_USERNAME=postgres
DB_PASSWORD=postgres

LIMIT_FILE_SIZE=5242880

# RS256 keypair for signing/verifying auth tokens (see README "Local setup")
